// Platform infrastructure tables (schema "platform"). Not a business module: these tables are
// written through platform/* services only (ADR-0001, ADR-0003). The CHECK constraints, the grants
// and the row-level security policy are hand-written in the migrations.

/// A row of one tenant that exists to prove the isolation layers end to end (ADR-0002 and the
/// Phase 0 PoC item 2): the tenant guard in Prisma and PostgreSQL row-level security. No
/// business data. The row-level security policy on this table is the reference for every
/// tenant-scoped table that follows.
model IsolationProbe {
  /// UUIDv7 from the IdGenerator.
  id        String   @id @db.Uuid
  /// The tenant (ADR-0002): mandatory, no default, first in every key.
  tenantId  String   @map("tenant_id") @db.VarChar(32)
  /// A short code chosen by the writer, unique within the tenant.
  label     String   @db.VarChar(64)
  /// From the injected Clock, UTC.
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  @@unique([tenantId, label], map: "isolation_probe_tenant_id_label_key")
  @@map("isolation_probe")
  @@schema("platform")
}

/// One delivery of one event to one subscriber (ported from Mondapac platform.prisma, the
/// in-process bus of ADR-0006; Mondapac platform persistence design 6.3 and 6.4). The relay fans
/// each published event out to a `pending` row per subscription of its type, with a copy of the
/// envelope; the dispatcher claims due rows and runs their handlers. Phoenix: the tenant leads
/// every key and row-level security applies (ADR-0002), so the relay and the dispatcher set the
/// tenant in each of their transactions. The CHECKs, the claim index, the grants and the policy
/// are hand-written in the migration.
model EventDelivery {
  /// The tenant of the event (ADR-0002): mandatory, no default, first in every key.
  tenantId         String    @map("tenant_id") @db.VarChar(32)
  /// The event's id (the outbox row's event_id).
  eventId          String    @map("event_id") @db.Uuid
  /// "<module>.<handler>": the subscription that receives the event.
  subscriber       String    @db.VarChar(96)
  /// pending | delivered | dead.
  status           String    @db.VarChar(16)
  /// Claims so far; each claim counts one.
  attempts         Int
  /// When the row is next due; moved forward by the back-off at every claim.
  nextAttemptAt    DateTime  @map("next_attempt_at") @db.Timestamptz(3)
  /// The envelope copy; never updated.
  type             String    @db.VarChar(128)
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(3)
  aggregateType    String    @map("aggregate_type") @db.VarChar(64)
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  correlationId    String    @map("correlation_id") @db.VarChar(128)
  causationId      String?   @map("causation_id") @db.Uuid
  payload          Json      @db.JsonB
  /// The last failure, as a code; never a message or a row value.
  errorCode        String?   @map("error_code") @db.VarChar(64)
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(3)
  deadAt           DateTime? @map("dead_at") @db.Timestamptz(3)

  /// ADR-0006: one row per event and subscriber, within the tenant.
  @@id([tenantId, eventId, subscriber])
  @@map("event_delivery")
  @@schema("platform")
}

/// One audited action (Phoenix ADR-0015; ported from Mondapac platform.prisma, its
/// platform-audit design 3 and data design 11). Append-only: a trigger refuses UPDATE, DELETE
/// and TRUNCATE for every role, and the application role has INSERT and SELECT only. Written
/// only by the AuditWriter of platform/persistence/audit/, inside the use case's transaction.
/// Values are ids and closed codes only: no personal data (ADR-0015 decision 2). The CHECKs,
/// the triggers, the grants and the row-level security policy are hand-written in the migration.
model AuditLog {
  /// The tenant (ADR-0002): mandatory, no default, first in every key.
  tenantId      String         @map("tenant_id") @db.VarChar(32)
  /// UUIDv7 from the IdGenerator.
  id            String         @db.Uuid
  /// Instant of the audited action, from the injected Clock, UTC, in whole milliseconds.
  occurredAt    DateTime       @map("occurred_at") @db.Timestamptz(3)
  /// USER = an authenticated actor (actor_id required); SYSTEM = a job, a worker or a consumed
  /// event; ANONYMOUS = a request with no session, naming its bound subject in after.boundSubjectId.
  actorType     String         @map("actor_type") @db.VarChar(16)
  /// The account id of an authenticated actor. A plain id, no foreign key across schemas.
  actorId       String?        @map("actor_id") @db.Uuid
  /// `<module>.<subject>.<verb>` or `platform.<component>[.<subject>].<verb>`, from a closed catalogue.
  action        String         @db.VarChar(128)
  /// `<owner>.<type>`: the aggregate or record that changed.
  targetType    String         @map("target_type") @db.VarChar(128)
  /// The target's id as text: a UUID or a declared natural key.
  targetId      String         @map("target_id") @db.VarChar(128)
  /// State before the change (null for a creation): declared fields only.
  before        Json?          @db.JsonB
  /// State after the change (null for a deletion): declared fields only.
  after         Json?          @db.JsonB
  /// Correlation id of the request, job run or event that caused the action.
  correlationId String         @map("correlation_id") @db.VarChar(128)
  /// The seals of this row, at most one per chain epoch.
  seals         AuditLogSeal[]

  @@id([tenantId, id], map: "audit_log_pkey")
  /// The sealer's keyset on (occurred_at, id); referenced by the seal's foreign key.
  @@unique([tenantId, occurredAt, id], map: "audit_log_tenant_id_occurred_at_id_key")
  /// The audit history of one target, newest first.
  @@index([tenantId, targetType, targetId, occurredAt], map: "audit_log_tenant_id_target_type_target_id_occurred_at_idx")
  /// What one actor did.
  @@index([tenantId, actorId, occurredAt], map: "audit_log_tenant_id_actor_id_occurred_at_idx")
  @@map("audit_log")
  @@schema("platform")
}

/// The seal of one audit row in its tenant's hash chain (Phoenix ADR-0015 decision 4; ported
/// from Mondapac). Append-only like the log. One chain per tenant and epoch. No personal data.
model AuditLogSeal {
  /// The tenant (ADR-0002): mandatory, no default, first in every key.
  tenantId        String   @map("tenant_id") @db.VarChar(32)
  /// Chain epoch, 1 from the first seal. No default.
  epoch           Int
  /// 1, 2, 3, ... per tenant and epoch.
  chainSeq        BigInt   @map("chain_seq")
  /// The sealed audit row.
  auditLogId      String   @map("audit_log_id") @db.Uuid
  /// Copy of the row's occurred_at, kept equal by the foreign key.
  auditOccurredAt DateTime @map("audit_occurred_at") @db.Timestamptz(3)
  /// 32 bytes: SHA-256 of the canonical row.
  rowHash         Bytes    @map("row_hash")
  /// 32 bytes: SHA-256 of the link, with hash_version and epoch in its input.
  chainHash       Bytes    @map("chain_hash")
  /// Sealed below the watermark; part of the chain hash.
  late            Boolean
  /// 1 today.
  hashVersion     Int      @map("hash_version") @db.SmallInt
  /// From the sealer's Clock; not part of any hash.
  sealedAt        DateTime @map("sealed_at") @db.Timestamptz(3)
  auditLog        AuditLog @relation(fields: [tenantId, auditOccurredAt, auditLogId], references: [tenantId, occurredAt, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, epoch, chainSeq], map: "audit_log_seal_pkey")
  @@unique([tenantId, epoch, auditOccurredAt, auditLogId], map: "audit_log_seal_tenant_id_epoch_occurred_at_id_key")
  @@map("audit_log_seal")
  @@schema("platform")
}

/// A chain head at checkpoint time, also sent to the anchor (ported from Mondapac). Append-only
/// like the seal; no foreign key to the seal. No personal data.
model AuditChainCheckpoint {
  /// The tenant (ADR-0002): mandatory, no default, first in every key.
  tenantId    String   @map("tenant_id") @db.VarChar(32)
  /// The epoch of the checkpointed seal.
  epoch       Int
  /// The head at checkpoint time.
  chainSeq    BigInt   @map("chain_seq")
  /// 32 bytes: the chain_hash of that seal.
  chainHash   Bytes    @map("chain_hash")
  hashVersion Int      @map("hash_version") @db.SmallInt
  /// From the sealer's Clock.
  createdAt   DateTime @map("created_at") @db.Timestamptz(3)

  @@id([tenantId, epoch, chainSeq], map: "audit_chain_checkpoint_pkey")
  @@map("audit_chain_checkpoint")
  @@schema("platform")
}

/// The data key of one subject of personal data (ADR-0003, ADR-0007: "personal data is
/// encrypted under per-subject keys; erasure = destroy the key"). The key is random, wrapped
/// with AES-256-GCM under the deployment's key-encryption key (SUBJECT_KEY_KEK), with the
/// tenant and the subject as associated data; the plain key never reaches the database.
/// Destroying sets `wrapped_key` to null for good: what was encrypted under it is unreadable.
/// Written by platform/subject-keys only. The CHECKs, grants and row-level security are
/// hand-written in the migration.
model SubjectKey {
  tenantId    String    @map("tenant_id") @db.VarChar(32)
  /// The subject: the record whose personal data the key protects (a form submission).
  subjectId   String    @map("subject_id") @db.Uuid
  /// The module that owns the subject (`forms`): a closed code, for operations and erasure.
  module      String    @db.VarChar(32)
  /// version byte | IV (12) | tag (16) | wrapped key (32); null once destroyed.
  wrappedKey  Bytes?    @map("wrapped_key")
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  destroyedAt DateTime? @map("destroyed_at") @db.Timestamptz(3)

  @@id([tenantId, subjectId], map: "subject_key_pkey")
  @@map("subject_key")
  @@schema("platform")
}

/// One fixed window of one rate-limit bucket (ADR-0010 `rate-limit`). The bucket is an HMAC of
/// the rule's name and its subject (a client address, an account id), so no address is stored.
/// Pruned by `platform.rate-limit-prune` once the window is a day old.
model RateLimitWindow {
  tenantId    String   @map("tenant_id") @db.VarChar(32)
  /// Hex HMAC-SHA-256 of `<rule>\n<subject>`.
  bucket      String   @db.VarChar(64)
  /// The start of the window, a multiple of the rule's window length since the epoch.
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  hits        Int

  @@id([tenantId, bucket, windowStart], map: "rate_limit_window_pkey")
  /// The prune job's scan.
  @@index([tenantId, windowStart], map: "rate_limit_window_tenant_id_window_start_idx")
  @@map("rate_limit_window")
  @@schema("platform")
}

/// A solved proof-of-work challenge (platform/captcha), kept until it expires so a solution
/// counts once. Pruned by `platform.rate-limit-prune`.
model CaptchaSpent {
  tenantId      String   @map("tenant_id") @db.VarChar(32)
  /// Hex SHA-256 of the challenge.
  challengeHash String   @map("challenge_hash") @db.VarChar(64)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)

  @@id([tenantId, challengeHash], map: "captcha_spent_pkey")
  @@index([tenantId, expiresAt], map: "captcha_spent_tenant_id_expires_at_idx")
  @@map("captcha_spent")
  @@schema("platform")
}
