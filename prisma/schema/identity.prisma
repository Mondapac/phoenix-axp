// The identity module (schema "identity"; Phase 1 slice 1.5): staff accounts, their opaque
// server-side sessions, roles and role assignments (ADR-0004 as amended by ADR-0019 and
// ADR-0020; ADR-0018 decision 6). Keycloak holds credentials and answers "who are you" only;
// this schema holds who may do what. The CHECKs, the grants and the row-level security policies
// are hand-written in the migration. Shape copied from the PoC 2 spike (identity.prisma).

/// An account of one person in one tenant (ADR-0019: one account per employee). Staff accounts
/// come from the tenant's directory (created on first sign-in, with no roles) or are local
/// (created in studio before the first sign-in).
model Account {
  /// UUIDv7 from the IdGenerator.
  id          String           @id @db.Uuid
  tenantId    String           @map("tenant_id") @db.VarChar(32)
  /// platform-operator | tenant-staff | portal-user. Fixed for the account's life.
  population  String           @db.VarChar(32)
  /// directory | local (ADR-0019 decision 3) for staff; one-time-code for a portal user
  /// (ADR-0026).
  source      String           @db.VarChar(16)
  /// The identity provider's subject (`sub`) of this person; null for a local account that has
  /// not signed in yet. Set once, never changed.
  subject     String?          @db.VarChar(255)
  /// The sign-in name, lower case: how a local account is matched on its first sign-in. Never
  /// logged, audited or put in an event. Null exactly for a portal user, whose address is a
  /// sealed PortalContact (ADR-0026).
  username    String?          @db.VarChar(255)
  /// active | disabled
  status      String           @db.VarChar(16)
  version     Int
  createdAt   DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @map("updated_at") @db.Timestamptz(3)
  sessions    Session[]
  assignments RoleAssignment[]
  contacts    PortalContact[]

  @@unique([tenantId, id], map: "account_tenant_id_id_key")
  @@unique([tenantId, subject], map: "account_tenant_id_subject_key")
  @@unique([tenantId, username], map: "account_tenant_id_username_key")
  @@map("account")
  @@schema("identity")
}

/// An opaque server-side session (ADR-0004 decision 2): only the SHA-256 of the token is stored,
/// and nothing about it is cached. Ending a session deletes its row.
model Session {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.VarChar(32)
  accountId    String   @map("account_id") @db.Uuid
  /// SHA-256 of the session token: 32 bytes.
  tokenHash    Bytes    @map("token_hash")
  /// The identity provider's session id (`sid`), for back-channel logout.
  idpSessionId String?  @map("idp_session_id") @db.VarChar(255)
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  account      Account  @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "session_account_fkey")

  @@unique([tenantId, id], map: "session_tenant_id_id_key")
  @@unique([tenantId, tokenHash], map: "session_tenant_id_token_hash_key")
  @@index([tenantId, accountId], map: "session_tenant_id_account_id_idx")
  @@index([tenantId, idpSessionId], map: "session_tenant_id_idp_session_id_idx")
  @@map("session")
  @@schema("identity")
}

/// A role of the tenant: a named set of permission keys (ADR-0004 decision 7). A system role
/// holds every key of its scope by definition and stores none. Versioning (ADR-0007): a
/// mutable aggregate with `version` (optimistic lock); its history is the audit log
/// (`identity.role.created`, `identity.role.permissions-changed`).
model Role {
  id               String                @id @db.Uuid
  tenantId         String                @map("tenant_id") @db.VarChar(32)
  /// Unique in the tenant, kebab case.
  key              String                @db.VarChar(64)
  /// system | default | custom
  kind             String                @db.VarChar(16)
  /// platform | tenant | site
  scope            String                @db.VarChar(16)
  /// The keys the role confers; empty for a system role. A key the registry does not declare
  /// grants nothing.
  permissionKeys   String[]              @map("permission_keys") @db.VarChar(128)
  version          Int
  createdAt        DateTime              @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @map("updated_at") @db.Timestamptz(3)
  assignments      RoleAssignment[]
  definitionScopes RoleDefinitionScope[]
  fieldRules       RoleFieldRule[]

  @@unique([tenantId, id], map: "role_tenant_id_id_key")
  /// The target of role_assignment's foreign key, which makes a grant's level its role's scope.
  @@unique([tenantId, id, scope], map: "role_tenant_id_id_scope_key")
  @@unique([tenantId, key], map: "role_tenant_id_key_key")
  @@map("role")
  @@schema("identity")
}

/// A role granted to an account, at the role's own level (ADR-0018 decision 6): tenant-wide, or
/// at one site of the tenancy module (an id, not a foreign key: no relation crosses schemas),
/// for that site only or for its subtree too. Versioning (ADR-0007): inserted and deleted,
/// never updated; its history is the audit log (`identity.role.assigned`, `.revoked`).
model RoleAssignment {
  id                 String   @id @db.Uuid
  tenantId           String   @map("tenant_id") @db.VarChar(32)
  accountId          String   @map("account_id") @db.Uuid
  roleId             String   @map("role_id") @db.Uuid
  /// platform | tenant | site; equals the role's scope.
  level              String   @db.VarChar(16)
  siteId             String?  @map("site_id") @db.Uuid
  includeDescendants Boolean  @map("include_descendants")
  createdAt          DateTime @map("created_at") @db.Timestamptz(3)
  account            Account  @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "role_assignment_account_fkey")
  /// Through the role's scope too: a grant sits at its role's level (ADR-0018 decision 6).
  role               Role     @relation(fields: [tenantId, roleId, level], references: [tenantId, id, scope], onDelete: Restrict, onUpdate: Restrict, map: "role_assignment_role_fkey")

  @@unique([tenantId, id], map: "role_assignment_tenant_id_id_key")
  /// One grant of a role to an account per place. NULLS NOT DISTINCT in the migration, so a
  /// tenant grant (no site) is unique too; Prisma cannot say so, and a regenerated index would
  /// drop the clause silently: test/db/identity.db-spec.ts proves it holds.
  @@unique([tenantId, accountId, roleId, siteId], map: "role_assignment_tenant_id_account_id_role_id_site_id_key")
  @@index([tenantId, roleId], map: "role_assignment_tenant_id_role_id_idx")
  @@map("role_assignment")
  @@schema("identity")
}

/// The definition qualifier of a qualified key a custom role confers (ADR-0024 decision 2): every
/// definition of the tenant, those created later included, or the listed ones (ids of the
/// forms or objects module, not foreign keys: no relation crosses schemas). A qualified key
/// without a row covers no definition. A row of a key the role no longer confers, or an id of a
/// definition that is gone, grants nothing: readers ignore it. Versioning (ADR-0007, V1): part of the role, whose
/// version every change bumps; its history is the audit log (`identity.role.definition-scope-changed`).
model RoleDefinitionScope {
  tenantId       String   @map("tenant_id") @db.VarChar(32)
  roleId         String   @map("role_id") @db.Uuid
  permissionKey  String   @map("permission_key") @db.VarChar(128)
  allDefinitions Boolean  @map("all_definitions")
  /// Empty under all_definitions; 1 to 256 ids otherwise.
  definitionIds  String[] @map("definition_ids") @db.Uuid
  role           Role     @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "role_definition_scope_role_fkey")

  @@id([tenantId, roleId, permissionKey], map: "role_definition_scope_pkey")
  @@map("role_definition_scope")
  @@schema("identity")
}

/// A custom role's mode for one field of one definition (ADR-0024 decision 3): hidden, read or
/// edit, keyed by the field's stable id, so renaming a field keeps the rule. A field without a
/// rule follows the operation (sensitive fields are hidden). Inserted and deleted, never
/// updated: a change replaces the role's rules of one definition and bumps the role's version
/// (V1); its history is the audit log (`identity.role.field-rules-changed`).
model RoleFieldRule {
  tenantId     String @map("tenant_id") @db.VarChar(32)
  roleId       String @map("role_id") @db.Uuid
  definitionId String @map("definition_id") @db.Uuid
  fieldId      String @map("field_id") @db.Uuid
  /// hidden | read | edit
  mode         String @db.VarChar(8)
  role         Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "role_field_rule_role_fkey")

  @@id([tenantId, roleId, definitionId, fieldId], map: "role_field_rule_pkey")
  @@map("role_field_rule")
  @@schema("identity")
}

/// The tenant's staff directory sync (ADR-0022 decision 6), one row per tenant, written on first
/// need. Keycloak sends nothing when a user is disabled in AD, so this sync is what ends a
/// directory account's access: the longest delay is the interval.
model DirectorySync {
  tenantId         String    @id @map("tenant_id") @db.VarChar(32)
  /// Minutes between two runs, 1 to 60; 5 unless the tenant changed it.
  intervalMinutes  Int       @map("interval_minutes") @db.SmallInt
  /// When the last run started (claimed), whatever its outcome; null before the first run.
  lastStartedAt    DateTime? @map("last_started_at") @db.Timestamptz(3)
  /// completed | failed | halted; null before the first run ends.
  lastOutcome      String?   @map("last_outcome") @db.VarChar(16)
  lastFinishedAt   DateTime? @map("last_finished_at") @db.Timestamptz(3)
  accountsChecked  Int       @map("accounts_checked")
  accountsDisabled Int       @map("accounts_disabled")
  accountsEnabled  Int       @map("accounts_enabled")
  /// Optimistic concurrency of the interval only; a run claims on last_started_at instead.
  version          Int
  updatedAt        DateTime  @map("updated_at") @db.Timestamptz(3)

  @@map("directory_sync")
  @@schema("identity")
}

/// The portal sign-in settings of a tenant (ADR-0026 decision 2; owner decision P1). No row
/// means no method: a tenant's portal sign-in is closed until staff open it. Versioning
/// (ADR-0007): a mutable settings row with `version`; its history is the audit log
/// (`identity.portal-sign-in.settings-changed`).
model PortalSignInSettings {
  tenantId           String   @id @map("tenant_id") @db.VarChar(32)
  /// The methods a portal user may sign in with: email, mobile, both or none.
  methods            String[] @db.VarChar(16)
  /// The country calling code that turns a national mobile number (leading 0) into E.164,
  /// digits only; null accepts international numbers only.
  countryCallingCode String?  @map("country_calling_code") @db.VarChar(4)
  version            Int
  updatedAt          DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("portal_sign_in_settings")
  @@schema("identity")
}

/// The address a portal user signs in with (ADR-0026 decision 4): sealed under the account's
/// subject key, found by its keyed hash. One per kind and account; an address belongs to one
/// account of the tenant. Versioning (ADR-0007): inserted, never updated.
model PortalContact {
  tenantId   String   @map("tenant_id") @db.VarChar(32)
  accountId  String   @map("account_id") @db.Uuid
  /// email | mobile
  kind       String   @db.VarChar(16)
  /// HMAC-SHA-256 of the normalised address under the blind-index key: 32 bytes.
  lookupHash Bytes    @map("lookup_hash")
  /// The normalised address, sealed under the account's subject key.
  sealed     Bytes
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)
  account    Account  @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "portal_contact_account_fkey")

  @@id([tenantId, accountId, kind], map: "portal_contact_pkey")
  @@unique([tenantId, kind, lookupHash], map: "portal_contact_tenant_id_kind_lookup_hash_key")
  @@map("portal_contact")
  @@schema("identity")
}

/// A one-time sign-in code sent to an address (ADR-0026 decision 3). Neither the code nor the
/// address is stored: only their keyed hashes. Versioning (ADR-0007): a short-lived row,
/// updated as answers are tried and deleted by the prune job a day after it expires.
model PortalCode {
  /// UUIDv7 from the IdGenerator; the browser holds it between the two steps.
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.VarChar(32)
  /// email | mobile
  kind       String    @db.VarChar(16)
  /// The keyed hash of the address, as PortalContact.lookupHash.
  lookupHash Bytes     @map("lookup_hash")
  /// HMAC-SHA-256 of the code, bound to the id: 32 bytes.
  codeHash   Bytes     @map("code_hash")
  /// Wrong answers so far; the code is spent at the limit.
  failures   Int       @db.SmallInt
  createdAt  DateTime  @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  /// Set when the right answer, or the last wrong one, spends the code.
  spentAt    DateTime? @map("spent_at") @db.Timestamptz(3)

  @@unique([tenantId, id], map: "portal_code_tenant_id_id_key")
  @@index([tenantId, expiresAt], map: "portal_code_tenant_id_expires_at_idx")
  @@map("portal_code")
  @@schema("identity")
}
