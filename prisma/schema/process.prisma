// The process module (schema "process"; Phase 2 slice 2.2): the bridge to Flowable (ADR-0005 as
// amended by ADR-0020 decisions 6, 7 and 9). The core owns the published process revisions, the
// instances it started, its mirror of the engine's user tasks, the commands it sends to the
// engine, the observations it took from the engine and the incidents the bridge found. Flowable
// owns execution, in its own database, never this one. Shape copied from the PoC 3 spike
// (process.prisma). The CHECKs, the grants and the row-level security policies are hand-written
// in the migration.

/// V1 immutable revision: a BPMN process definition as the tenant published it. Never updated;
/// deployed to the engine under the tenant, one deployment per revision.
model ProcessRevision {
  /// UUIDv7 from the IdGenerator.
  id          String            @id @db.Uuid
  tenantId    String            @map("tenant_id") @db.VarChar(32)
  /// The BPMN process id, which is the engine's definition key.
  processKey  String            @map("process_key") @db.VarChar(64)
  /// 1, 2, ... per process key.
  revision    Int
  bpmnXml     String            @map("bpmn_xml")
  /// `sha256:` and the hex SHA-256 of the XML.
  contentHash String            @map("content_hash") @db.VarChar(71)
  /// The core's settings of each user task, read from the model at publication (slice 2.3,
  /// ADR-0025): an object of task key to attributes, checked again when read.
  taskSettings Json             @default("{}") @map("task_settings")
  publishedAt DateTime          @map("published_at") @db.Timestamptz(3)
  instances   ProcessInstance[]
  /// The form revisions its start event and user tasks name (slice 2.6).
  formBindings ProcessFormBinding[]

  @@unique([tenantId, id], map: "process_revision_tenant_id_id_key")
  @@unique([tenantId, processKey, revision], map: "process_revision_tenant_id_process_key_revision_key")
  @@map("process_revision")
  @@schema("process")
}

/// V3 snapshot at reference: one run of exactly one process revision, as the core started it.
/// Its id is the engine instance's business key: the idempotency key of the start.
model ProcessInstance {
  /// UUIDv7 from the IdGenerator.
  id               String          @id @db.Uuid
  tenantId         String          @map("tenant_id") @db.VarChar(32)
  revisionId       String          @map("revision_id") @db.Uuid
  /// The site the run belongs to (its task queues are at this site); null for a tenant-level
  /// run, which only tenant grants reach (slice 2.3).
  siteId           String?         @map("site_id") @db.Uuid
  /// starting | running | completed | cancelled
  status           String          @db.VarChar(16)
  /// The engine instance the core adopted: set once, first writer wins (ADR-0020 decision 9).
  engineInstanceId String?         @map("engine_instance_id") @db.VarChar(64)
  requestedAt      DateTime        @map("requested_at") @db.Timestamptz(3)
  endedAt          DateTime?       @map("ended_at") @db.Timestamptz(3)
  /// The forms submission that started it (slice 2.6), a plain id across schemas; null when the
  /// core started it otherwise. One instance per submission.
  submissionId     String?         @map("submission_id") @db.Uuid
  version          Int
  revision         ProcessRevision @relation(fields: [tenantId, revisionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "process_instance_revision_fkey")
  tasks            ProcessTask[]

  @@unique([tenantId, id], map: "process_instance_tenant_id_id_key")
  @@unique([tenantId, engineInstanceId], map: "process_instance_tenant_id_engine_instance_id_key")
  @@unique([tenantId, submissionId], map: "process_instance_tenant_id_submission_id_key")
  @@index([tenantId, revisionId], map: "process_instance_tenant_id_revision_id_idx")
  @@map("process_instance")
  @@schema("process")
}

/// The core's mirror of one engine user task, ever (ADR-0005 decision 4). The engine decides that
/// a task exists and when it ends; the core decides who may act on it (slice 2.3). Versioning
/// (ADR-0007): a mutable aggregate with `version` (open, completing, then an end status); its history is
/// the engine's task history and the incidents.
model ProcessTask {
  /// UUIDv7 from the IdGenerator.
  id            String          @id @db.Uuid
  tenantId      String          @map("tenant_id") @db.VarChar(32)
  instanceId    String          @map("instance_id") @db.Uuid
  engineTaskId  String          @map("engine_task_id") @db.VarChar(64)
  /// The BPMN user task id.
  taskKey       String          @map("task_key") @db.VarChar(255)
  /// The BPMN form key, when the model names one.
  formKey       String?         @map("form_key") @db.VarChar(255)
  /// The forms revision the task shows (slice 2.6): the one its process revision bound at publish,
  /// a plain id across schemas. Null when the model names no form.
  formRevisionId String?        @map("form_revision_id") @db.Uuid
  /// open | completing | completed | superseded | escalated | cancelled
  status        String          @db.VarChar(16)
  /// The engine command of the completion: the key stored on the engine task (PoC 3 R4).
  completionKey String?         @map("completion_key") @db.Uuid
  // The inbox (slice 2.3, ADR-0025), copied from the instance and the revision's task settings
  // when the task is first seen; the core alone changes the assignment.
  /// The instance's site; null for a tenant-level run.
  siteId            String?   @map("site_id") @db.Uuid
  /// The user task's name in the model, the tenant's text.
  name              String?   @db.VarChar(255)
  /// The queue: a role at the site; null for a task sent to one person or not assigned yet.
  candidateRoleId   String?   @map("candidate_role_id") @db.Uuid
  /// Who holds the task: claimed, assigned, or the modeller's direct assignee.
  assigneeAccountId String?   @map("assignee_account_id") @db.Uuid
  dueAt             DateTime? @map("due_at") @db.Timestamptz(3)
  /// The queue the task moves to when its deadline passes.
  escalationRoleId  String?   @map("escalation_role_id") @db.Uuid
  escalatedAt       DateTime? @map("escalated_at") @db.Timestamptz(3)
  /// The outcome codes a person picks from; empty when the task offers none.
  outcomes          String[]  @default([]) @db.VarChar(32)
  /// The outcome of the completion the core asked for; kept when the deadline superseded it.
  outcome           String?   @db.VarChar(32)
  openedAt      DateTime        @map("opened_at") @db.Timestamptz(3)
  closedAt      DateTime?       @map("closed_at") @db.Timestamptz(3)
  version       Int
  instance      ProcessInstance @relation(fields: [tenantId, instanceId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "process_task_instance_fkey")

  @@unique([tenantId, engineTaskId], map: "process_task_tenant_id_engine_task_id_key")
  @@index([tenantId, instanceId], map: "process_task_tenant_id_instance_id_idx")
  @@index([tenantId, assigneeAccountId], map: "process_task_tenant_id_assignee_account_id_idx")
  @@index([tenantId, candidateRoleId], map: "process_task_tenant_id_candidate_role_id_idx")
  @@map("process_task")
  @@schema("process")
}

/// Core -> engine commands (ADR-0005 decision 3; ADR-0020 decision 7). Written in the unit of
/// the state change; the relay claims a row with a lease, calls the engine outside any unit,
/// then acks it in another unit. Not the module's in-process event outbox. Versioning (ADR-0007):
/// a queue row, updated only by its claim, release and ack (`attempts` is the claim's lock).
model EngineCommand {
  /// UUIDv7 from the IdGenerator; also the completion key of a `complete-task`.
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.VarChar(32)
  /// deploy-revision | deploy-decision | start-instance | complete-task | delete-orphan
  kind          String    @db.VarChar(32)
  /// The revision, decision revision, instance or task the command is about.
  subjectId     String    @map("subject_id") @db.Uuid
  /// Ids, codes and numbers only (ADR-0005 decision 7): never personal data.
  payload       Json
  correlationId String    @map("correlation_id") @db.VarChar(128)
  /// Claims so far; the claim is a compare-and-set on it.
  attempts      Int
  /// Not claimable before: the lease of a claim, or the retry time after a failed call.
  notBefore     DateTime  @map("not_before") @db.Timestamptz(3)
  /// The code of the last failure, never a message.
  lastError     String?   @map("last_error") @db.VarChar(64)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  /// Set when the engine refused the command for good; an incident says why.
  deadAt        DateTime? @map("dead_at") @db.Timestamptz(3)

  @@index([tenantId, subjectId], map: "engine_command_tenant_id_subject_id_idx")
  @@map("engine_command")
  @@schema("process")
}

/// Engine -> core observations already applied, per handler (ADR-0020 decision 8): the inbox of
/// the bridge. The event id is derived from what was observed, so a repeated poll finds its row.
/// Versioning (ADR-0007): V4 append-only (INSERT + SELECT only).
model EngineObservation {
  tenantId   String   @map("tenant_id") @db.VarChar(32)
  eventId    String   @map("event_id") @db.Uuid
  handler    String   @db.VarChar(64)
  observedAt DateTime @map("observed_at") @db.Timestamptz(3)

  @@id([tenantId, eventId, handler], map: "engine_observation_pkey")
  @@map("engine_observation")
  @@schema("process")
}

/// The engine sync's watermarks of one tenant (PoC 3 R5): the latest end time, on the engine's
/// clock, of the ended tasks and the ended instances already read. Versioning (ADR-0007): one
/// mutable row per tenant with `version` (optimistic lock); no history kept.
model EngineSyncState {
  tenantId            String    @id @map("tenant_id") @db.VarChar(32)
  tasksEndedAfter     DateTime? @map("tasks_ended_after") @db.Timestamptz(3)
  instancesEndedAfter DateTime? @map("instances_ended_after") @db.Timestamptz(3)
  version             Int
  updatedAt           DateTime  @map("updated_at") @db.Timestamptz(3)

  @@map("engine_sync_state")
  @@schema("process")
}

/// V4 append-only: what the bridge found that should not happen (an orphan engine instance, a
/// task completed outside the core, a command the engine refused). For operators; one row per
/// kind and engine object.
model ProcessIncident {
  /// UUIDv7 from the IdGenerator.
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.VarChar(32)
  kind       String   @db.VarChar(48)
  /// The engine object concerned (instance or task id), or the core id of a refused command.
  engineRef  String   @map("engine_ref") @db.VarChar(64)
  /// The core instance, when known.
  instanceId String?  @map("instance_id") @db.Uuid
  detectedAt DateTime @map("detected_at") @db.Timestamptz(3)

  @@unique([tenantId, kind, engineRef], map: "process_incident_tenant_id_kind_engine_ref_key")
  @@index([tenantId, detectedAt], map: "process_incident_tenant_id_detected_at_idx")
  @@map("process_incident")
  @@schema("process")
}

/// A tenant's working calendar (owner decision D4; slice 2.3): the weekdays not worked and the
/// holidays the tenant administrator enters; working-day deadlines count on it. No default
/// source of holidays: a tenant without a row works every day. Versioning (ADR-0007): one
/// mutable row per tenant with `version` (stale write = 409); its history is the audit log.
model WorkingCalendar {
  tenantId    String     @id @map("tenant_id") @db.VarChar(32)
  /// ISO weekdays, 1 = Monday ... 7 = Sunday.
  weekendDays Int[]      @map("weekend_days") @db.SmallInt
  /// ISO dates in the tenant's time zone.
  holidays    DateTime[] @db.Date
  version     Int
  updatedAt   DateTime   @map("updated_at") @db.Timestamptz(3)

  @@map("working_calendar")
  @@schema("process")
}

/// V1, inserted with its process revision and never changed (slice 2.6; ADR-0005 decision 5):
/// the form a BPMN element names by its form key, pinned to the form revision that was published
/// when the process revision was. `start` is the start event (a submission of the form starts
/// the process); `task` is a user task (the task shows that revision). Form ids are plain ids
/// across schemas, resolved through the forms facade at publish.
model ProcessFormBinding {
  tenantId       String          @map("tenant_id") @db.VarChar(32)
  revisionId     String          @map("revision_id") @db.Uuid
  /// The BPMN element id: the start event's, or the user task's (its task key).
  elementId      String          @map("element_id") @db.VarChar(64)
  /// start | task
  kind           String          @db.VarChar(8)
  formId         String          @map("form_id") @db.Uuid
  formRevisionId String          @map("form_revision_id") @db.Uuid
  revision       ProcessRevision @relation(fields: [tenantId, revisionId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "process_form_binding_revision_fkey")

  @@id([tenantId, revisionId, elementId], map: "process_form_binding_pkey")
  @@map("process_form_binding")
  @@schema("process")
}

/// Which process a form starts (slice 2.6): one process key per form and one form per key,
/// claimed by the first revision that binds the form to its start event; later revisions of the
/// key must keep that start form (no release yet). Publishing the claim needs
/// `forms.forms.publish` on the form. A partial unique index (migration only) also keeps one
/// start binding per revision.
/// Versioning (ADR-0007): insert-only, no history needed (the bindings hold it).
model ProcessStartForm {
  tenantId   String   @map("tenant_id") @db.VarChar(32)
  formId     String   @map("form_id") @db.Uuid
  processKey String   @map("process_key") @db.VarChar(64)
  claimedAt  DateTime @map("claimed_at") @db.Timestamptz(3)

  @@id([tenantId, formId], map: "process_start_form_pkey")
  @@unique([tenantId, processKey], map: "process_start_form_tenant_id_process_key_key")
  @@map("process_start_form")
  @@schema("process")
}

/// Events the process module's subscribers have handled (ADR-0006; slice 2.6): `runOnce` inserts
/// (tenant, event, handler) in the handler's own unit and skips the work when the row exists.
/// Written only by platform/persistence/outbox/.
model ProcessInbox {
  tenantId    String   @map("tenant_id") @db.VarChar(32)
  eventId     String   @map("event_id") @db.Uuid
  /// The subscriber's name, "process.<handler>".
  handler     String   @db.VarChar(96)
  processedAt DateTime @map("processed_at") @db.Timestamptz(3)

  @@id([tenantId, eventId, handler])
  @@map("inbox")
  @@schema("process")
}

/// Mutable working copy of one process key (slice 2.10, owner decision D7): what a designer
/// saves in the modeler before a publisher publishes it as a revision. Its history is the
/// published revisions; the draft itself is overwritten under `version` (409 conflict.stale).
/// Never deployed or executed: only `process_revision` reaches the engine.
model ProcessDraft {
  /// UUIDv7 from the IdGenerator.
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.VarChar(32)
  /// The BPMN process id the model carries.
  processKey String   @map("process_key") @db.VarChar(64)
  bpmnXml    String   @map("bpmn_xml")
  version    Int
  updatedAt  DateTime @map("updated_at") @db.Timestamptz(3)

  @@unique([tenantId, id], map: "process_draft_tenant_id_id_key")
  @@unique([tenantId, processKey], map: "process_draft_tenant_id_process_key_key")
  @@map("process_draft")
  @@schema("process")
}

/// V1 immutable revision: a DMN decision table as the tenant published it (slice 2.7). Never
/// updated; deployed to the engine under the tenant, one deployment per revision. A process's
/// decision task runs the latest revision of its key in the instance's tenant (the engine finds
/// it by key at the step): a table is the tenant's living rule, changed without republishing the
/// processes that use it.
model DecisionRevision {
  /// UUIDv7 from the IdGenerator.
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.VarChar(32)
  /// The DMN decision id, which is the engine's decision key.
  decisionKey String   @map("decision_key") @db.VarChar(64)
  /// 1, 2, ... per decision key.
  revision    Int
  dmnXml      String   @map("dmn_xml")
  /// `sha256:` and the hex SHA-256 of the XML.
  contentHash String   @map("content_hash") @db.VarChar(71)
  publishedAt DateTime @map("published_at") @db.Timestamptz(3)

  @@unique([tenantId, id], map: "decision_revision_tenant_id_id_key")
  @@unique([tenantId, decisionKey, revision], map: "decision_revision_tenant_id_decision_key_revision_key")
  @@map("decision_revision")
  @@schema("process")
}
