# Copy to .env for local development. Never commit .env.
# Every variable the application reads must be listed and explained here.

# HTTP port the API listens on.
PORT=3000

# Optional. The interface the API listens on, for example 127.0.0.1 or the address only the
# BFFs reach; every interface when unset. The BFFs set x-tenant-id, so in a deployment nothing
# else should reach the API port.
# HOST=

# development | test | production.
NODE_ENV=development

# true | false. Serves Swagger UI at /docs. Off by default; keep it off in production.
API_DOCS_ENABLED=true

# Log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# Required. api | worker; no default. `api` serves HTTP; `worker` runs background work and
# opens no port.
APP_ROLE=api

# Required. Comma-separated tenant ids this deployment serves (ADR-0002). There is no default
# tenant: the API refuses to start when this is missing or empty, and every tenant-scoped
# request must name one of these in the x-tenant-id header.
HOSTED_TENANTS=demo-fa,demo-en

# Optional. Directory with one <tenant-id>.json per tenant. Defaults to config/tenants in the
# repository. Every tenant in HOSTED_TENANTS must have a valid file there.
# TENANT_CONFIG_DIR=

# Required. PostgreSQL connection URL of the application login (`phoenix_api`, a member of the
# group role `phoenix_app`). The only database URL the application reads: it may insert and
# read what the migrations grant, row-level security limits it to the tenant of the open unit
# of work, and it refuses to start when this role can do more. The value matches
# scripts/db/bootstrap-dev.sql. It contains credentials: keep real values out of the repository
# and out of logs.
DATABASE_URL=postgresql://phoenix_api:phoenix_api@localhost:5432/phoenix

# Optional. Integer from 1 to 100, default 10. Size of the connection pool of each process.
DATABASE_POOL_MAX=10

# Object storage (ADR-0012): an S3-compatible store, SeaweedFS from docker-compose.yml locally.
# S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY are set together, or all
# left unset: then every storage call fails. Required in production. Outside production a
# missing bucket is created at start-up; in production the API refuses to start without it.
# The key below matches infra/seaweedfs/s3.json and is local-only. The secret is a credential:
# keep real values out of the repository and out of logs. `pnpm test:storage` and
# `pnpm verify` read the endpoint and key (each run makes its own buckets).
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=phoenix
S3_ACCESS_KEY_ID=phoenix
S3_SECRET_ACCESS_KEY=phoenix-dev-secret
# Optional. The store's URL as browsers reach it, for signed download URLs; S3_ENDPOINT unless
# set (behind a reverse proxy, for example).
# S3_PUBLIC_ENDPOINT=
# Optional. Region for request signing; us-east-1 unless set. SeaweedFS ignores it.
# S3_REGION=us-east-1

# Sessions (ADR-0004 decision 2). Required in production: at least 32 random bytes, base64url
# (for example `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`).
# The key of the CSRF tokens (HMAC of the session token) and of the sign-in flows. When unset
# outside production, each process draws a random key, so CSRF tokens and pending sign-ins do
# not survive a restart. A credential: keep real values out of the repository and out of logs.
# SESSION_SECRET=
# Comma-separated panel origins (scheme, host and port; https in production). A state-changing
# request with a session must carry one of them in Origin, plus the session's CSRF token in
# x-csrf-token. Empty refuses every such request.
PANEL_ORIGINS=http://localhost:3001
# Optional. How long a staff session lives, in hours: 1 to 24, default 8.
# STAFF_SESSION_HOURS=8

# Staff sign-in through Keycloak (ADR-0004 decision 1): OIDC Authorization Code + PKCE against
# one realm per tenant (owner decision P2). KEYCLOAK_URL, KEYCLOAK_STUDIO_CLIENT_SECRET and
# STUDIO_SIGN_IN_CALLBACK_URL are set together, or all left unset: then every sign-in answers
# 503 sign-in.unavailable. Required in production. Keycloak from docker-compose.yml listens on
# KEYCLOAK_PORT (8180).
# KEYCLOAK_URL=http://localhost:8180
# Optional. The realm of a tenant; {tenant} is replaced by the tenant id. Default phoenix-{tenant}.
# KEYCLOAK_REALM_TEMPLATE=phoenix-{tenant}
# Optional. The confidential studio client of every realm (standard flow, PKCE S256 required).
# KEYCLOAK_STUDIO_CLIENT_ID=phoenix-studio
# The studio client's secret. A credential: keep real values out of the repository and logs.
# KEYCLOAK_STUDIO_CLIENT_SECRET=
# The redirect URI registered on the studio client: the studio BFF's callback route, which
# forwards code and state to GET /identity/staff/sign-in/callback.
# STUDIO_SIGN_IN_CALLBACK_URL=http://localhost:3001/auth/callback
# Optional. The ID-token claim that marks a directory (LDAP/AD) user: add a "User Attribute"
# mapper of LDAP_ID to the studio client under this claim name. Default ldap_id.
# KEYCLOAK_DIRECTORY_CLAIM=ldap_id
# The directory sync (owner decision P6) reads each tenant realm's users with a confidential
# service-account client that holds realm-management "view-users" only. Required in
# production; without the secret the sync answers "failed" and a user disabled in AD keeps
# access until the session expires. The client id defaults to phoenix-core-admin.
# KEYCLOAK_ADMIN_CLIENT_ID=phoenix-core-admin
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# Flowable REST (ADR-0005; process bridge, slice 2.2): the base URL, reachable from the core's
# network only, and the core's credential. All three or none; required in production. Unset:
# every engine call fails as unavailable and process commands wait.
# FLOWABLE_URL=http://localhost:8080/flowable-rest/service
# FLOWABLE_USER=
# FLOWABLE_PASSWORD=

# For `pnpm test:db` only: the Flowable the bridge's real-engine tests use (REST base URL, and the
# password of `rest-admin` unless FLOWABLE_TEST_USER is set). CI sets them; without them locally
# those tests are skipped and the rest of test:db runs.
# FLOWABLE_TEST_URL=http://localhost:8090/flowable-rest/service
# FLOWABLE_TEST_USER=rest-admin
# FLOWABLE_TEST_PASSWORD=

# Required for `pnpm db:*`, `pnpm test:db` and `pnpm verify` only. PostgreSQL connection URL of
# the migration role (`phoenix_migrator`), which owns the database and creates and drops the
# test databases. The application never reads it and refuses to start when it is set in its
# environment. It contains credentials, like DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://phoenix_migrator:phoenix_migrator@localhost:5432/phoenix

# Flowable in docker-compose.yml (slice 2.1): REST user rest-admin / phoenix-dev-flowable, its own
# database `flowable` (login flowable / flowable). Nothing in the API reads these yet (slice 2.2).

# Optional host ports for docker-compose.yml, if the defaults are taken on your machine:
# POSTGRES_PORT=5432  VALKEY_PORT=6379  SMTP_PORT=1025  MAILPIT_UI_PORT=8025
# KEYCLOAK_PORT=8180  FLOWABLE_PORT=8090  S3_PORT=8333  SEAWEED_MASTER_PORT=9333
# SEAWEED_FILER_PORT=8888
