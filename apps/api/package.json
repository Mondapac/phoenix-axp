{
  "name": "@phoenix/api",
  "version": "0.0.0",
  "private": true,
  "description": "Phoenix AXP API: NestJS modular monolith (roles: api | worker).",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:db": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.db.config.cjs",
    "test:storage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.storage.config.cjs",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@phoenix/shared-kernel": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "graphql": "^17.0.2",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.2.1",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "re2js": "2.9.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^18.5.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14"
  }
}
