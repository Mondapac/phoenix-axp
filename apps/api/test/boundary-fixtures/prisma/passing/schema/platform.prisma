// Allowed: a scoped model whose only key is the single-column UUID @id.
model PlatformProbe {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id")
  label    String

  @@map("probe")
  @@schema("platform")
}

// Allowed: an audit model, reserved to platform/persistence/audit/ by the source check.
model AuditLog {
  tenantId String @map("tenant_id")
  id       String @db.Uuid
  action   String

  @@id([tenantId, id])
  @@map("audit_log")
  @@schema("platform")
}
