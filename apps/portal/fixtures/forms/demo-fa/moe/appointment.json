{
  "_revision": { "form": "appointment", "revision": 1, "publishedAt": "2026-10-20T09:00:00Z" },
  "schema": {
    "type": "object",
    "properties": {
      "fullName": { "type": "string", "minLength": 3, "maxLength": 80 },
      "nationalCode": { "type": "string", "pattern": "^[0-9]{10}$" },
      "mobile": { "type": "string", "pattern": "^09[0-9]{9}$" },
      "birthDate": { "type": "string", "format": "date" },
      "requestType": { "type": "string", "enum": ["certificate", "complaint", "information"] },
      "description": { "type": "string", "maxLength": 500 }
    },
    "required": ["fullName", "nationalCode", "mobile", "birthDate", "requestType"],
    "additionalProperties": false
  },
  "uischema": {
    "type": "VerticalLayout",
    "elements": [
      {
        "type": "Group",
        "label": "applicant",
        "elements": [
          {
            "type": "Control",
            "scope": "#/properties/fullName",
            "options": { "autoComplete": "name" }
          },
          {
            "type": "Control",
            "scope": "#/properties/nationalCode",
            "options": { "normalise": "identifier", "inputMode": "numeric" }
          },
          {
            "type": "Control",
            "scope": "#/properties/mobile",
            "options": { "normalise": "identifier", "inputMode": "numeric", "autoComplete": "tel" }
          },
          { "type": "Control", "scope": "#/properties/birthDate" }
        ]
      },
      {
        "type": "Group",
        "label": "request",
        "elements": [
          { "type": "Control", "scope": "#/properties/requestType" },
          { "type": "Control", "scope": "#/properties/description", "options": { "multi": true } }
        ]
      }
    ]
  },
